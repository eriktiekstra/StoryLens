{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoryLens CLI results v1",
  "type": "object",
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "root": {
          "type": "string"
        },
        "discovered": {
          "type": "integer",
          "minimum": 0
        },
        "indexed": {
          "type": "integer",
          "minimum": 0
        },
        "analyzed": {
          "type": "integer",
          "minimum": 0
        },
        "cache_hits": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "error": {
                "type": "string"
              },
              "stage": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "error"
            ],
            "additionalProperties": false
          }
        },
        "errors_truncated": {
          "type": "boolean"
        },
        "stages": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "analyzed": {
                "type": "integer",
                "minimum": 0
              },
              "cache_hits": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "analyzed",
              "cache_hits",
              "failed"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "root",
        "discovered",
        "indexed",
        "analyzed",
        "cache_hits",
        "failed",
        "errors",
        "errors_truncated"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/identity"
              },
              {
                "$ref": "#/$defs/media"
              }
            ]
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "media": {
          "$ref": "#/$defs/media"
        }
      },
      "required": [
        "schema_version",
        "media"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "error"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "media_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "paths": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "media_id",
              "paths"
            ],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "const": "exact"
        }
      },
      "required": [
        "schema_version",
        "items",
        "next_cursor",
        "mode"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "left_id": {
                "type": "string"
              },
              "right_id": {
                "type": "string"
              },
              "hamming_distance": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              },
              "color_distance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "aspect_ratio_difference": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "left_id",
              "right_id",
              "hamming_distance",
              "color_distance",
              "aspect_ratio_difference"
            ],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "const": "near"
        },
        "search": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "items",
        "next_cursor",
        "mode",
        "search"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/scene"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "media_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provenance": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "items",
        "next_cursor",
        "media_id",
        "provenance"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "space": {
          "type": "string"
        },
        "depth": {
          "enum": [
            "fast",
            "standard",
            "deep"
          ]
        },
        "metric": {
          "const": "cosine"
        },
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "media_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "score": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "evidence": {
                "$ref": "#/$defs/semantic_evidence"
              }
            },
            "required": [
              "media_id",
              "score",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "ranking": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "space",
        "depth",
        "metric",
        "items",
        "limit",
        "ranking"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "provenance": {
          "type": "object"
        },
        "source_timing": {
          "type": "object"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "segments": {
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "provenance",
        "source_timing",
        "language",
        "segments"
      ],
      "additionalProperties": true
    }
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "audio"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "first_seen": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "size",
        "first_seen"
      ],
      "additionalProperties": false
    },
    "path": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "media_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "mtime_ns": {
          "type": "integer"
        },
        "ctime_ns": {
          "type": "integer"
        },
        "birthtime": {
          "type": [
            "number",
            "null"
          ]
        },
        "last_seen": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "media_id",
        "size",
        "mtime_ns",
        "ctime_ns",
        "birthtime",
        "last_seen"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string"
            },
            "tool": {
              "enum": [
                "Pillow",
                "ffprobe"
              ]
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "tool",
            "version"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "schema_version",
        "provenance"
      ],
      "additionalProperties": true
    },
    "failure": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "attempted_at": {
          "type": "string"
        }
      },
      "required": [
        "stage",
        "error",
        "attempted_at"
      ],
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "audio"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "first_seen": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "analysis": {
          "type": "object",
          "properties": {
            "metadata": {
              "$ref": "#/$defs/metadata_stage"
            },
            "image_technical": {
              "$ref": "#/$defs/image_stage"
            },
            "video_technical": {
              "$ref": "#/$defs/video_stage"
            },
            "semantic_embeddings": {
              "$ref": "#/$defs/embedding_stage"
            },
            "semantic_vision": {
              "$ref": "#/$defs/vision_stage"
            },
            "audio_technical": {
              "$ref": "#/$defs/audio_technical_stage"
            },
            "audio_transcription": {
              "$ref": "#/$defs/audio_transcription_stage"
            },
            "transcript": {
              "$ref": "#/$defs/transcript_stage"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "size",
        "first_seen",
        "paths",
        "analysis",
        "failures"
      ],
      "additionalProperties": false
    },
    "image_technical": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "provenance": {
          "type": "object"
        },
        "resolution": {
          "type": "object"
        },
        "preprocessing": {
          "type": "object"
        },
        "metrics": {
          "type": "object"
        },
        "similarity": {
          "type": "object"
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "provenance",
        "resolution",
        "preprocessing",
        "metrics",
        "similarity",
        "caveats"
      ],
      "additionalProperties": true
    },
    "scene": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "start_seconds": {
          "type": "number"
        },
        "end_seconds": {
          "type": "number"
        },
        "end_rational_seconds": {
          "type": "object",
          "properties": {
            "numerator": {
              "type": "integer"
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "additionalProperties": false
        },
        "start_pts": {
          "type": "integer"
        },
        "time_base": {
          "type": "object",
          "properties": {
            "numerator": {
              "type": "integer"
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "additionalProperties": false
        },
        "boundary_evidence": {
          "type": "object"
        },
        "representative_frame": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "source_timestamp_seconds": {
              "type": "number"
            },
            "pts": {
              "type": "integer"
            },
            "time_base": {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "integer"
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "numerator",
                "denominator"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "path",
            "source_timestamp_seconds",
            "pts",
            "time_base"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "index",
        "start_seconds",
        "end_seconds",
        "end_rational_seconds",
        "start_pts",
        "time_base",
        "boundary_evidence",
        "representative_frame"
      ],
      "additionalProperties": true
    },
    "video_technical": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "provenance": {
          "type": "object"
        },
        "source_timing": {
          "type": "object"
        },
        "derivatives": {
          "type": "object"
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scene"
          }
        },
        "measurements": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "provenance",
        "source_timing",
        "derivatives",
        "scenes",
        "measurements"
      ],
      "additionalProperties": true
    },
    "metadata_stage": {
      "type": "object",
      "properties": {
        "cache_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "analyzed_at": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "cache_key",
        "analyzed_at",
        "result"
      ],
      "additionalProperties": false
    },
    "image_stage": {
      "type": "object",
      "properties": {
        "cache_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "analyzed_at": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/image_technical"
        }
      },
      "required": [
        "cache_key",
        "analyzed_at",
        "result"
      ],
      "additionalProperties": false
    },
    "video_stage": {
      "type": "object",
      "properties": {
        "cache_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "analyzed_at": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/video_technical"
        }
      },
      "required": [
        "cache_key",
        "analyzed_at",
        "result"
      ],
      "additionalProperties": false
    },
    "semantic_evidence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "image"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "video_frame"
            },
            "scene_index": {
              "type": "integer",
              "minimum": 0
            },
            "start_seconds": {
              "type": "number"
            },
            "end_seconds": {
              "type": "number"
            },
            "representative_frame": {
              "type": "object"
            }
          },
          "required": [
            "kind",
            "scene_index",
            "start_seconds",
            "end_seconds",
            "representative_frame"
          ],
          "additionalProperties": false
        }
      ]
    },
    "embedding_stage": {
      "type": "object",
      "properties": {
        "cache_key": {
          "type": "string"
        },
        "analyzed_at": {
          "type": "string"
        },
        "result": {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "1.0"
            },
            "provenance": {
              "type": "object",
              "required": [
                "algorithm",
                "provider",
                "space",
                "depth",
                "task",
                "video_cache_key",
                "selection"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "evidence": {
                    "$ref": "#/$defs/semantic_evidence"
                  },
                  "vector": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 65536,
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "required": [
                  "evidence",
                  "vector"
                ],
                "additionalProperties": false
              }
            },
            "coverage": {
              "type": "object",
              "properties": {
                "selected_frames": {
                  "type": "integer",
                  "minimum": 0
                },
                "available_frames": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "selected_frames",
                "available_frames"
              ],
              "additionalProperties": false
            },
            "caveats": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "schema_version",
            "provenance",
            "items",
            "coverage",
            "caveats"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "cache_key",
        "analyzed_at",
        "result"
      ],
      "additionalProperties": false
    },
    "vision_stage": {
      "type": "object",
      "properties": {
        "cache_key": {
          "type": "string"
        },
        "analyzed_at": {
          "type": "string"
        },
        "result": {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "1.0"
            },
            "provenance": {
              "type": "object",
              "required": [
                "algorithm",
                "provider",
                "space",
                "depth",
                "task",
                "video_cache_key",
                "selection"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "evidence": {
                    "$ref": "#/$defs/semantic_evidence"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "interpretation": {
                    "const": "model_hypothesis"
                  },
                  "confidence": {
                    "type": "null"
                  }
                },
                "required": [
                  "evidence",
                  "description",
                  "interpretation",
                  "confidence"
                ],
                "additionalProperties": false
              }
            },
            "coverage": {
              "type": "object",
              "properties": {
                "selected_frames": {
                  "type": "integer",
                  "minimum": 0
                },
                "available_frames": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "selected_frames",
                "available_frames"
              ],
              "additionalProperties": false
            },
            "caveats": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "schema_version",
            "provenance",
            "items",
            "coverage",
            "caveats"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "cache_key",
        "analyzed_at",
        "result"
      ],
      "additionalProperties": false
    },
    "transcript": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "provenance": {
          "type": "object"
        },
        "source_timing": {
          "type": "object"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "start_seconds": {
                "type": "number"
              },
              "end_seconds": {
                "type": "number"
              },
              "text": {
                "type": "string"
              },
              "speaker": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "words": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start_seconds": {
                      "type": "number"
